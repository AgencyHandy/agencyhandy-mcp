{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.agencyhandy/mcp",
  "title": "Agency Handy",
  "description": "Agency CRM, projects, tasks, tickets, invoices and proposals in your Agency Handy workspace.",
  "version": "1.10.1",
  "websiteUrl": "https://agencyhandy.com",
  "repository": {
    "url": "https://github.com/AgencyHandy/agencyhandy-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/AgencyHandy/agencyhandy-mcp/main/assets/logo-400.png",
      "mimeType": "image/png",
      "sizes": ["400x400"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.agencyhandy.com/",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer followed by your Agency Handy workspace API key (Settings > Workspace Config > API Key)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
